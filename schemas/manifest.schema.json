{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pluhub.dev/spec/manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "host",
    "runtime",
    "provides",
    "requires",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,95}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 400 },
    "category": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9.-]*$" },
    "codeReload": { "enum": ["restart", "parallel"] },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry"],
      "properties": {
        "kind": {
          "enum": ["native", "process"]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
      }
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "pattern": "^[a-z][a-z0-9.-]{1,95}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": ["linux", "win32", "darwin"]
      }
    },
    "configSchema": {
      "type": "object"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "title", "path"],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "public": {
          "type": "boolean"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "entry"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*$"
              },
              "entry": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$",
          "maxLength": 64
        },
        "order": {
          "type": "number"
        },
        "pages": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "path"],
            "properties": {
              "title": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "public": {
                "type": "boolean"
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*$",
                "maxLength": 64
              },
              "order": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "configReload": {
      "enum": ["restart", "snapshot"]
    },
    "optionalRequires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
      }
    }
  }
}
