{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataDir", "plugins"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataDir": {
      "type": "string",
      "minLength": 1
    },
    "drainTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pluginSources": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "grants"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
          },
          "grants": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "integrity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "config": {
            "type": "object"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["registryId", "version", "archiveSha256"],
            "properties": {
              "registryId": { "type": "string" },
              "version": { "type": "string" },
              "archiveSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "pluginRegistries": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "enabled": { "type": "boolean" },
          "allowPrivateNetwork": { "type": "boolean" }
        }
      }
    }
  }
}
