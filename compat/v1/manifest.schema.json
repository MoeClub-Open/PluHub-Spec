{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pluhub.dev/spec/manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "host",
    "runtime",
    "provides",
    "requires",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,95}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entry"
      ],
      "properties": {
        "kind": {
          "enum": [
            "native",
            "process"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "linux",
          "win32",
          "darwin"
        ]
      }
    },
    "configSchema": {
      "type": "object"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "title",
        "path"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "public": {
          "type": "boolean"
        }
      }
    },
    "configReload": {
      "enum": [
        "restart",
        "snapshot"
      ]
    },
    "optionalRequires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
      }
    }
  }
}
